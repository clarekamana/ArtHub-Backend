# Server
PORT=4000
NODE_ENV=development
APP_BASE_URL=http://localhost:4000

# Auth
JWT_SECRET=change-me-super-secret
JWT_EXPIRES_IN=7d

# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,https://arthub.vercel.app

# Set to true only on the single free Render web service that also runs the
# BullMQ workers in-process (no free Background Worker instance type available).
# Set to false once conversion/lifecycle run as their own paid worker services.
ENABLE_WORKERS=false

# Database (Postgres - metadata only, never file bytes)
DATABASE_URL=postgresql://arthub:arthub@localhost:5432/arthub?schema=public
# Direct (unpooled) connection, required by Prisma Migrate when DATABASE_URL is a
# PgBouncer/pooled endpoint (e.g. Neon's "-pooler" host) - can equal DATABASE_URL otherwise
DIRECT_URL=postgresql://arthub:arthub@localhost:5432/arthub?schema=public

# Redis (BullMQ job queue for scanning/conversion/lifecycle workers)
REDIS_URL=redis://localhost:6379

# Object storage - S3-compatible (Cloudflare R2 / Backblaze B2 / MinIO / AWS S3)
S3_ENDPOINT=http://localhost:9000
S3_REGION=auto
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true

# Buckets per Section 4.2/4.4: quarantine (private, unscanned) vs public (scanned + promoted)
S3_BUCKET_QUARANTINE=arthub-quarantine
S3_BUCKET_PUBLIC=arthub-public
S3_BUCKET_ARCHIVE=arthub-archive

# CDN base URL fronting the public bucket (Section 4.2 step 8)
CDN_BASE_URL=http://localhost:9000/arthub-public

# Presigned URL TTLs (seconds) - Section 5.3
PRESIGN_UPLOAD_TTL=900
PRESIGN_DOWNLOAD_TTL=14400

# Quotas (bytes) - Section 9.1 / 9.3
QUOTA_FREE_BYTES=2147483648
QUOTA_VERIFIED_BYTES=10737418240
MAX_FILE_SIZE_IMAGE=20971520
MAX_FILE_SIZE_VECTOR=104857600
MAX_FILE_SIZE_3D_STANDARD=524288000
MAX_FILE_SIZE_3D_EXCEPTION=2147483648
